<Page
    x:Class="Calculator.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
		<Grid x:Name="mainMenuGrid">

			<Image
Source="Assets/abacus.jpg"
Width="100"
Height="100"
HorizontalAlignment="Right"
VerticalAlignment="Top"
Margin="0,20,20,0"/>


			<StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Width="300">

				<TextBlock
        Text="Universal Calculator"
        FontSize="32"
        HorizontalAlignment="Center"
        Margin="0,0,0,30"/>

				<Button
        Content="Math Calculator" Click="Math_Button_Click"
        Margin="0,5"/>

				<Button
        Content="Mortgage Calculator" Click="Mortgage_Button_Click"
        Margin="0,5"/>

				<Button
        Content="Currency Calculator" Click="Currency_Button_Click"
        Margin="0,5"/>

				<Button
        Content="Exit" Click="Exit_Button_Click"
        Margin="0,5"/>

			</StackPanel>
		</Grid>
	</Grid>
</Page>
